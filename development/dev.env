# Local test environment settings. Throwaway credentials for a container that
# only ever listens on localhost -- these are NOT secrets and must never be
# reused anywhere real.

# --- version pins: match the EEN test cluster ---
NAUTOBOT_VERSION=3.0.11
PYTHON_VER=3.12
NAUTOBOT_PORT=8081

# --- postgres ---
POSTGRES_USER=nautobot
POSTGRES_PASSWORD=notasecret
POSTGRES_DB=nautobot
NAUTOBOT_DB_HOST=db
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=notasecret

# --- redis ---
NAUTOBOT_REDIS_HOST=redis
NAUTOBOT_REDIS_PORT=6379

# --- nautobot ---
NAUTOBOT_SECRET_KEY=localdevonly-not-a-real-secret-key-0123456789
NAUTOBOT_ALLOWED_HOSTS=*
NAUTOBOT_DEBUG=True
NAUTOBOT_LOG_LEVEL=INFO

# post_upgrade runs migrations on first boot; the image default of 30s is not
# enough for an empty database.
MAX_DB_WAIT_TIME=600

# --- auto-created admin user + fixed API token ---
NAUTOBOT_CREATE_SUPERUSER=true
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
NAUTOBOT_SUPERUSER_PASSWORD=admin
NAUTOBOT_SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567
